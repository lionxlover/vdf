{
  "id": "./",
  "name": "VDF Viewer",
  "short_name": "VDF",
  "description": "Open .vdf (Vacter Document File) documents \u2014 offline, nothing uploaded.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2457FF",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/vnd.vacter.vdf": [
          ".vdf"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}